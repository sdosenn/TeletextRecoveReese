<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="300"
        x:Class="TeletextRecoveReese.AboutWindow"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Title="About">
    
    <StackPanel Margin="20" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
        <!-- Application Title -->
        <TextBlock Text="TeletextRecoveReese" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center"/>
        
        <!-- Version Info -->
        <TextBlock x:Name="VersionText" HorizontalAlignment="Center"/>
        
        <!-- Kyle Reese Real Size Image via Resource -->
        <Image Source="avares://TeletextRecoveReese/Assets/kyle_reese.jpg" 
               Stretch="None" 
               HorizontalAlignment="Center" 
               Margin="0,5,0,5"/>
        
        <!-- Author / Copyright / Support -->
        <TextBlock Text="Created by: Siniša Došen" HorizontalAlignment="Center"/>
        <TextBlock Text="© 2026" Foreground="Gray" HorizontalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
            <TextBlock Text="Support:" Foreground="Gray" VerticalAlignment="Center"/>
            <TextBlock Text="ko-fi.com/sinisinavideoteka"
                       Foreground="#4DA3FF"
                       TextDecorations="Underline"
                       Cursor="Hand"
                       PointerPressed="OnSupportLinkPressed"/>
        </StackPanel>

        <!-- Close Button -->
        <Button Content="Close" Click="CloseButton_Click" HorizontalAlignment="Center" Margin="0,5,0,0" Width="80" HorizontalContentAlignment="Center"/>
    </StackPanel>
</Window>
