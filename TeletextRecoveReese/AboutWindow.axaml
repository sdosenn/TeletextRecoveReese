<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="300"
        x:Class="TeletextRecoveReese.AboutWindow"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Icon="/Assets/Icons/app-icon.png"
        Title="About">
    
    <StackPanel Margin="20" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
        <!-- Application Title -->
        <TextBlock Text="TeletextRecoveReese" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center"/>
        
        <!-- Version Info -->
        <TextBlock x:Name="VersionText" HorizontalAlignment="Center"/>
        
        <!-- Kyle Reese Real Size Image via Resource -->
        <Image Source="avares://TeletextRecoveReese/Assets/kyle_reese.jpg" 
               Stretch="None" 
               HorizontalAlignment="Center" 
               Margin="0,5,0,5"/>
        
        <!-- Author / Copyright / Support -->
        <TextBlock Text="Created by: Siniša Došen  © 2026" HorizontalAlignment="Center"/>
        <Grid ColumnDefinitions="*,Auto" Margin="0,5,0,0" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                <Button Height="32"
                        Padding="10,3"
                        Cursor="Hand"
                        ToolTip.Tip="https://github.com/sdosenn/TeletextRecoveReese"
                        Click="OnRepositoryLinkClicked">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{}{ C# }"
                                   FontFamily="Consolas,DejaVu Sans Mono,monospace"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#A978E8"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="GitHub" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Height="32"
                        Padding="10,3"
                        Cursor="Hand"
                        ToolTip.Tip="https://ko-fi.com/sinisinavideoteka"
                        Click="OnSupportLinkClicked">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="☕" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Ko-fi" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <Button Grid.Column="1"
                    Content="Close"
                    Click="CloseButton_Click"
                    HorizontalAlignment="Right"
                    Width="80"
                    Height="32"
                    HorizontalContentAlignment="Center"/>
        </Grid>
    </StackPanel>
</Window>
